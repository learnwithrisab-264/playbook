<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.JarvisTube" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- MIUI/ColorOS "force dark" recolours apps that do not opt out: it dimmed our whites
             and inverted the selected chip. The app already has its own dark theme. -->
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
